{
 "type": "AdaptiveCard",
 "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
 "version": "1.5",
 "body": [
  {
   "type": "TextBlock",
   "text": "Recently played",
   "weight": "Bolder",
   "size": "Medium"
  },
  {
   "type": "TextBlock",
   "text": "Nothing played yet",
   "isSubtle": true,
   "$when": "${count == 0}"
  },
  {
   "type": "Container",
   "$data": "${items}",
   "separator": true,
   "selectAction": {
    "type": "Action.Execute",
    "verb": "play",
    "data": {
     "id": "${id}"
    }
   },
   "items": [
    {
     "type": "TextBlock",
     "text": "${title}",
     "weight": "Bolder",
     "wrap": true,
     "maxLines": 1
    },
    {
     "type": "TextBlock",
     "text": "${sub}",
     "isSubtle": true,
     "spacing": "None",
     "size": "Small",
     "maxLines": 1
    }
   ]
  }
 ]
}